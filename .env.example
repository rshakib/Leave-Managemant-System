# Copy this file to .env (in the repo root) and adjust the values.
# docker-compose.yml reads these to start the containers.
# .env is git-ignored; this example file is safe to commit.

POSTGRES_USER=leave_user
POSTGRES_PASSWORD=leave_password
# Use leave_db for a fresh database (adjust if connecting to an existing DB):
POSTGRES_DB=leave_db
POSTGRES_PORT=5432

# Ports mapped to host machine:
BACKEND_PORT=8000
FRONTEND_PORT=5173

JWT_SECRET=insecure-docker-secret-change-in-production-1234567890


