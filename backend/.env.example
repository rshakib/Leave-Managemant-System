# Copy this file to backend/.env and adjust values as needed.
# (backend/.env is git-ignored; this example file is safe to commit.)

PROJECT_NAME="Leave Management System API"

# PostgreSQL connection string. Paste a Supabase URL as-is, or use the local
# Docker database below (uncomment one line).
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Paste the Supabase connection string here. Both forms work:
#   postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   postgresql://postgres:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
# A plain postgresql:// or postgres:// scheme is rewritten to +asyncpg for you, and
# sslmode is translated to ssl (asyncpg rejects the libpq spelling).
# The :6543 transaction pooler switches prepared statements off automatically.
DATABASE_URL=postgresql://leave_user:leave_password@localhost:5432/leave_db

# Signs the JWT access tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# Comma-separated list of frontend origins allowed by CORS (no wildcard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where leave attachments are stored (relative paths resolve to backend/).
MEDIA_DIR=media
MAX_UPLOAD_BYTES=5242880

# --- Email / notifications (Phase 13) ---
# console | file | smtp  (never send real mail from development)
EMAIL_BACKEND=console
EMAIL_FROM=leave-management@example.invalid
# FILE backend writes one .eml per message here (git-ignored).
EMAIL_FILE_DIR=outbox_dev
FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated extra Cc addresses for the "fully approved" email.
NOTIFY_CC_ADMIN_EMAILS=
NOTIFY_CC_ADMINS_ON_FINAL=false
# IANA timezone name, e.g. Asia/Dhaka. Decides what "today" is for reminders.
ORG_TIMEZONE=UTC
REMINDER_AFTER_WORKING_DAYS=2
ENABLE_APPROVAL_REMINDERS=false
EMAIL_MAX_ATTEMPTS=5

# SMTP (only used when EMAIL_BACKEND=smtp):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# 465 only (implicit TLS). Leave false for 587.
SMTP_SSL=false

# Reports: refuse an export larger than this (narrow the filters instead).
EXPORT_MAX_ROWS=50000

# --- Security (Phase 16C) ---
# development | test | production. Production refuses to start if unsafe.
APP_ENV=development
# Access tokens are SHORT-LIVED: the frontend keeps them in memory only and
# refreshes silently when one expires.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Number of proxies you actually run in front of the API (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_COUNT=0
# Keyed HMAC used to hash client IPs. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
IP_HASH_KEY=
LOGIN_PAIR_LIMIT=5
LOGIN_PAIR_WINDOW_MINUTES=15
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_EMAIL_LIMIT=20
LOGIN_EMAIL_WINDOW_MINUTES=60
# Leave empty for "on in development, off in production".
ENABLE_DOCS=

# Set this only for a pooler on a non-standard port (it turns prepared
# statements off for every connection):
DB_STATEMENT_CACHE_DISABLED=false
